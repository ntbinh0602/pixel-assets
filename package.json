{
  "name": "nightwood-pixel-assets",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "services": "docker compose up -d --wait",
    "content": "node scripts/build-content.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test",
    "test:journey": "node tests/journey.mjs",
    "test:all": "npm run check && npm test && npm run test:browser",
    "db:backup": "node scripts/backup.mjs"
  },
  "engines": {
    "node": ">=20.19 <25"
  },
  "dependencies": {
    "better-auth": "^1.7.26",
    "dotenv": "^18.0.10",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
