# Local: docker compose up -d, npm install, npm run dev
PORT=5173
HOST=127.0.0.1
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://nightwood:nightwood_local_only@127.0.0.1:54329/nightwood
# Set a random secret of at least 32 characters when deploying.
BETTER_AUTH_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Nightwood <hello@nightwood.local>
# Production: NODE_ENV=production, HOST=0.0.0.0, HTTPS APP_URL,
# Neon DATABASE_URL (SSL), Render secret, Resend SMTP + verified MAIL_FROM.
# Production on Render: EMAIL_PROVIDER=resend; deliver via HTTPS, not SMTP.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
# Enable only behind Render's reverse proxy; leave false for direct Node hosting.
TRUST_PROXY=false
